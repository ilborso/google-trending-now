{
    "actorSpecification": 1,
    "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
            "search_parameters": {
                "type": "object",
                "description": "Echoes the request parameters used, including defaults applied."
            },
            "title": {
                "type": "string",
                "description": "The trending search topic"
            },
            "search_volume": {
                "type": "integer",
                "description": "Approximate search volume"
            },
            "growth_percentage": {
                "type": "integer",
                "description": "Percentage growth in search interest"
            },
            "started_at": {
                "type": "integer",
                "description": "Unix timestamp when the trend started"
            },
            "ended_at": {
                "type": "integer",
                "description": "Unix timestamp when the trend ended. Omitted if still active"
            },
            "status": {
                "type": "string",
                "description": "active or ended"
            },
            "related_queries": {
                "type": "array",
                "items": {
                    "type": "string"
                },
                "description": "Related search queries. May be empty"
            },
            "category_ids": {
                "type": "array",
                "items": {
                    "type": "integer"
                },
                "description": "Category IDs this trend belongs to. May be empty"
            },
            "category_description": {
                "type": "array",
                "items": {
                    "type": "string"
                },
                "description": "Human-readable category descriptions"
            },
            "trend_url": {
                "type": "string",
                "description": "Link to explore this trend on Google Trends"
            },
            "ai_marketing_intelligence": {
                "type": "object",
                "description": "AI-generated marketing intelligence insights for the trend",
                "properties": {
                    "why_it_matters": {
                        "type": "string",
                        "description": "Short description of the trend context or trigger (max 15 words)"
                    },
                    "affected_sectors": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Relevant industry verticals (2-3 items)"
                    },
                    "marketing_angle": {
                        "type": "string",
                        "description": "Tactical idea for newsjacking, editorial plan, or content creation"
                    },
                    "paid_ads_advice": {
                        "type": "string",
                        "description": "Recommendation for Google Ads / Meta Ads"
                    },
                    "brand_safety_risk": {
                        "type": "string",
                        "enum": [
                            "Low",
                            "Medium",
                            "High"
                        ],
                        "description": "Risk level for brand safety"
                    },
                    "recent_news_link": {
                        "type": "string",
                        "description": "URL link to a news article or site about the trend"
                    }
                }
            }
        }
    },
    "views": {
        "trends_overview": {
            "title": "Trends Overview",
            "transformation": {
                "fields": [
                    "title",
                    "search_volume",
                    "growth_percentage",
                    "started_at",
                    "status",
                    "category_description",
                    "trend_url"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "title": {
                        "label": "Trend Title",
                        "format": "text"
                    },
                    "search_volume": {
                        "label": "Search Volume",
                        "format": "number"
                    },
                    "growth_percentage": {
                        "label": "Growth %",
                        "format": "number"
                    },
                    "started_at": {
                        "label": "Started At",
                        "format": "number"
                    },
                    "status": {
                        "label": "Status",
                        "format": "text"
                    },
                    "category_description": {
                        "label": "Categories",
                        "format": "object"
                    },
                    "trend_url": {
                        "label": "Trend URL",
                        "format": "link"
                    }
                }
            }
        },
        "full_response": {
            "title": "Full Response",
            "transformation": {
                "fields": [
                    "search_parameters",
                    "trends"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "search_parameters": {
                        "label": "Search Parameters",
                        "format": "object"
                    },
                    "trends": {
                        "label": "Trends",
                        "format": "object"
                    }
                }
            }
        }
    }
}